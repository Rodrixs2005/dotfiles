{
    "logo": {
        "source": "~/.config/fastfetch/logo.png",
        "type": "kitty",
        "height": 8,
        "width": 20,
        "padding": {
            "top": 1,
            "left": 1
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[38;2;248;124;99m┌ Hardware 💻 ​─────────────────┐"
        },
        {
            "type": "host",
            "key": "󰋊 PC",
            "keyColor": "#F87C63",
            "format": "{1}"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#F87C63",
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": "│ └󰍛",
            "keyColor": "#F87C63",
            "format": "{2}"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;124;99m└──────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;114;99;248m┌ System 🐧 ───────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#7263F8",
            "format": "{name}"
        },
        {
            "type": "wm",
            "key": "│ ├",
            "keyColor": "#7263F8"
        },
        {
            "type": "de",
            "key": "│ ├",
            "keyColor": "#7263F8"
        },
        {
            "type": "kernel",
            "key": "│ └",
            "keyColor": "#7263F8"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;114;99;248m└──────────────────────────────┘"
        }
    ]
}